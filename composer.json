{
    "name": "cck/filament-mui-date-picker",
    "description": "A Filament form field that replicates MUI's DatePicker with full Livewire integration",
    "keywords": [
        "cck",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "mui-date-picker",
        "date-picker"
    ],
    "homepage": "https://github.com/cck/filament-mui-date-picker",
    "support": {
        "issues": "https://github.com/cck/filament-mui-date-picker/issues",
        "source": "https://github.com/cck/filament-mui-date-picker"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "cck",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0",
        "filament/forms": "^4.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Cck\\FilamentMuiDatePicker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cck\\FilamentMuiDatePicker\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cck\\FilamentMuiDatePicker\\MuiDatePickerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
